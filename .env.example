# High Court Clerk CPT — environment (copy to .env; never commit .env)

# ---- Server ----
NODE_ENV=development
PORT=4000
COOKIE_SECRET=change-me-to-a-long-random-string

# ---- MySQL 8 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hcc
DB_PASSWORD=
DB_NAME=hcc_cpt
DB_POOL=10

# ---- Razorpay (Orders API + webhook; added in Phase 4) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Email verification (SMTP) — sign-up code delivery ----
# Defaults target a Hostinger mailbox. Set SMTP_USER + SMTP_PASS to send real
# email; leave them blank to log the code to the server console in dev.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@highcourtexam.online
SMTP_PASS=
# Optional: defaults to SMTP_USER / "High Court Clerk CPT".
SMTP_FROM=info@highcourtexam.online
SMTP_FROM_NAME=High Court Clerk CPT

# ---- SMS / OTP provider (Fast2SMS) — legacy, unused by the email sign-in flow ----
# Kept for reference; requires DLT approval to actually send in India.
SMS_PROVIDER=
SMS_API_KEY=
SMS_ROUTE=otp
SMS_SENDER_ID=
SMS_DLT_MESSAGE_ID=

# ---- Client (Vite) ----
# Public site origin, used for canonical URLs, sitemap and OG tags.
VITE_SITE_URL=https://highcourtexam.online
VITE_RAZORPAY_KEY_ID=
