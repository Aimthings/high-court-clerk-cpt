# High Court Clerk CPT — environment (copy to .env; never commit .env)

# ---- Server ----
NODE_ENV=development
PORT=4000
COOKIE_SECRET=change-me-to-a-long-random-string

# ---- MySQL 8 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hcc
DB_PASSWORD=
DB_NAME=hcc_cpt
DB_POOL=10

# ---- Razorpay (Orders API + webhook; added in Phase 4) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- SMS / OTP provider (Phase 4) ----
SMS_PROVIDER=
SMS_API_KEY=

# ---- Client (Vite) ----
# Public site origin, used for canonical URLs, sitemap and OG tags.
VITE_SITE_URL=https://highcourtclerkcpt.in
VITE_RAZORPAY_KEY_ID=
