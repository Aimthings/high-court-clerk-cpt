# High Court Clerk CPT — environment (copy to .env; never commit .env)

# ---- Server ----
NODE_ENV=development
PORT=4000
COOKIE_SECRET=change-me-to-a-long-random-string

# ---- MySQL 8 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hcc
DB_PASSWORD=
DB_NAME=hcc_cpt
DB_POOL=10

# ---- Razorpay (Orders API + webhook; added in Phase 4) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- SMS / OTP provider (Fast2SMS) ----
# Set SMS_PROVIDER=fast2sms and SMS_API_KEY to send real OTP SMS. Leave blank to
# log the code to the server console in dev instead of sending.
SMS_PROVIDER=fast2sms
SMS_API_KEY=
# Route: 'otp' (default; sends "Your OTP: <code>", no DLT needed) or 'dlt'.
SMS_ROUTE=otp
# Only for SMS_ROUTE=dlt: your approved sender id + DLT template (message) id.
SMS_SENDER_ID=
SMS_DLT_MESSAGE_ID=

# ---- Client (Vite) ----
# Public site origin, used for canonical URLs, sitemap and OG tags.
VITE_SITE_URL=https://highcourtexam.online
VITE_RAZORPAY_KEY_ID=
